# Path to the JSON file used to store session records.
# Required: punch refuses to start if this is not set.
PUNCH_DB_PATH=./punch-sessions.json

# Slack notification on clock-in/clock-out.
# Optional: if either is unset, notifications are silently skipped.
# Bot token needs the chat:write scope.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0000000000
